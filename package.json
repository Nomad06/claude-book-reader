{
  "name": "claude-book-reader",
  "version": "0.2.0",
  "private": true,
  "description": "A Claude Code mod that opens your PDF book while Claude works, in a window of its own or as text in the terminal.",
  "license": "Apache-2.0",
  "author": "Nomad06 (https://github.com/Nomad06)",
  "homepage": "https://github.com/Nomad06/claude-book-reader#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nomad06/claude-book-reader.git"
  },
  "bugs": "https://github.com/Nomad06/claude-book-reader/issues",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" && claude plugin test .",
    "test:server": "node --test \"test/*.test.mjs\"",
    "test:mod": "claude plugin test .",
    "validate": "claude plugin validate .",
    "update-pdfjs": "sh scripts/update-pdfjs.sh"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.10"
  }
}
