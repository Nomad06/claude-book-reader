{
  "name": "claude-book-reader",
  "version": "0.1.1",
  "private": true,
  "description": "A Claude Code mod that opens your PDF book while Claude works.",
  "license": "Apache-2.0",
  "repository": "github:Nomad06/claude-book-reader",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\" && claude plugin test .",
    "test:server": "node --test \"test/*.test.mjs\"",
    "test:mod": "claude plugin test .",
    "validate": "claude plugin validate .",
    "update-pdfjs": "sh scripts/update-pdfjs.sh"
  }
}
